# Bob Ignore File
# Prevents sensitive files from being included in Bob's context

# Environment variables and secrets
.env
.env.*
*.env
backend/.env
frontend/.env.local
frontend/.env.production

# API Keys and credentials
**/secrets/
**/credentials/
*.pem
*.key
*.crt
*api_key*
*secret*
*password*

# Database files
*.db
*.sqlite
*.sqlite3

# Configuration with sensitive data
config/production.json
config/secrets.json

# Bob sessions (may contain API keys in conversation)
bob_sessions/

# Node modules (too large)
node_modules/
.next/

# Python cache
__pycache__/
*.pyc
venv/
env/

# Build artifacts
dist/
build/
out/

# Logs (may contain sensitive info)
*.log
logs/

# IDE files
.vscode/
.idea/

# Temporary files
tmp/
temp/
*.tmp

# Made with Bob
